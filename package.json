{
  "name": "voooz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "bot": "node --env-file-if-exists=.env server/telegram.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build:standalone && playwright test"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/lora": "^5.2.8",
    "@twa-dev/sdk": "^8.0.2",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
