# Server-side configuration. Never add secrets to VITE_* variables.
PORT=3001
# Optional: launch a Telegram bot after hosting the Mini App over HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
# Free local inference. Ollama and the requested model must be running.
# No provider API key is needed. Do not expose port 11434 publicly.
VOOOZ_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Start the Ollama daemon with OLLAMA_NO_CLOUD=1 to keep inference local.
# Optional paid Yandex alternative, only when explicitly selected.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Optional alternative for deployments in OpenAI-supported territories only.
VOOOZ_AI_API_KEY=
VOOOZ_AI_MODEL=gpt-4.1
