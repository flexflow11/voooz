# Server-side configuration. Never add secrets to VITE_* variables.
PORT=3001
# Optional: launch a Telegram bot after hosting the Mini App over HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
# Server-side Yandex AI Studio. Add the key in hosting/environment secrets.
# Without both values the catalog remains available; live AI is not enabled.
VOOOZ_AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest
# Optional alternative for deployments in OpenAI-supported territories only.
VOOOZ_AI_API_KEY=
VOOOZ_AI_MODEL=gpt-4.1
